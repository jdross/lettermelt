{
  "name": "lettermelt",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "python3 -m http.server 5174 --bind 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:slow": "LETTERMELT_SLOW=1 node --test tests/*.test.js",
    "build": "npm run build:site",
    "build:site": "bash scripts/build_site.sh",
    "build:wordlists": "node scripts/build_wordlists.js",
