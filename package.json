    "supabase:reset": "npx supabase db reset",
    "supabase:functions": "npx supabase functions serve game --env-file supabase/.env.local"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "sharp": "^0.35.3",
    "terser": "^5.50.0"
  }
