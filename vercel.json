{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lettermelt.vercel.app" }],
      "destination": "https://lettermelt.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mp" }],
      "destination": "/invite.html"
    }
  ]
}
